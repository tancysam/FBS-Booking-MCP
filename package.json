{
  "name": "fbs-booking-mcp",
  "version": "0.1.0",
  "description": "MCP server for booking SMU facilities through the FBS Mobile (FBSM) web API",
  "type": "module",
  "private": true,
  "bin": {
    "fbs-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:plugins": "npm run build && node scripts/build-plugins.mjs",
    "setup:claude": "node scripts/setup-plugin.mjs claude",
    "setup:codex": "node scripts/setup-plugin.mjs codex",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "playwright-core": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
